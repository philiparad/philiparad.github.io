{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scientific Calculator",
  "version": "1.0.1",
  "identifier": "io.github.philiparad.fx991esplus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scientific Calculator — fx-991ES PLUS",
        "url": "index.html",
        "width": 410,
        "height": 775,
        "minWidth": 295,
        "minHeight": 570,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f4f4f4"
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "img-src": "'self' data: blob:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
