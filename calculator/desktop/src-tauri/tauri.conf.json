{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scientific Calculator",
  "version": "1.0.0",
  "identifier": "io.github.philiparad.fx991esplus",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scientific Calculator — fx-991ES PLUS",
        "url": "index.html?key=calculator",
        "width": 410,
        "height": 775,
        "minWidth": 295,
        "minHeight": 570,
        "resizable": true,
        "center": true,
        "backgroundColor": "#f4f4f4"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
